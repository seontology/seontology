{
  "@context": {
    "schema": "http://schema.org/",
    "seovoc": "https://w3id.org/seovoc/"
  },
  "@graph": [
    {
      "@id": "https://example.com/products/example-product",
      "@type": ["seovoc:WebPage", "schema:WebPage"],
      "seovoc:hasPageType": {"@id": "https://example.com/structured-data-profile/ProductDetailPageType"},
      "seovoc:usesStructuredDataProfile": {"@id": "https://example.com/structured-data-profile/ProductPageProfile-v1"},
      "schema:mainEntity": {"@id": "https://example.com/entities/example-product"},
      "schema:breadcrumb": {"@id": "https://example.com/products/example-product#breadcrumbs"}
    },
    {
      "@id": "https://example.com/entities/example-product",
      "@type": "schema:Product",
      "schema:name": "Example Product",
      "schema:offers": {"@id": "https://example.com/offers/example-product"}
    },
    {
      "@id": "https://example.com/offers/example-product",
      "@type": "schema:Offer",
      "schema:price": "99.00",
      "schema:priceCurrency": "USD"
    },
    {
      "@id": "https://example.com/products/example-product#breadcrumbs",
      "@type": "schema:BreadcrumbList"
    }
  ]
}
