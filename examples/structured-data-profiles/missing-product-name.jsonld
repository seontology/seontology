{
  "@context": {
    "schema": "http://schema.org/",
    "seovoc": "https://w3id.org/seovoc/"
  },
  "@graph": [
    {
      "@id": "https://example.com/products/missing-product-name",
      "@type": ["seovoc:WebPage", "schema:WebPage"],
      "seovoc:hasPageType": {"@id": "https://example.com/structured-data-profile/ProductDetailPageType"},
      "seovoc:usesStructuredDataProfile": {"@id": "https://example.com/structured-data-profile/ProductPageProfile-v1"},
      "schema:mainEntity": {"@id": "https://example.com/entities/missing-product-name"}
    },
    {
      "@id": "https://example.com/entities/missing-product-name",
      "@type": "schema:Product",
      "schema:offers": {"@id": "https://example.com/offers/missing-product-name"}
    },
    {
      "@id": "https://example.com/offers/missing-product-name",
      "@type": "schema:Offer",
      "schema:price": "99.00",
      "schema:priceCurrency": "USD"
    }
  ]
}
